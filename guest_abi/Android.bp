package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_headers {
    name: "libberberis_guest_abi_headers",
    defaults: [
        "berberis_enable_arm64_host_defaults",
        "berberis_guest_agnostic_defaults",
    ],
    host_supported: true,
    export_include_dirs: ["include"],
    header_libs: [
        "jni_headers",
        "libberberis_base_headers",
        "libberberis_calling_conventions_headers",
        "libberberis_guest_state_headers",
        "libberberis_runtime_library_headers",
        "libberberis_runtime_primitives_headers",
    ],
    export_header_lib_headers: [
        "jni_headers",
        "libberberis_base_headers",
        "libberberis_calling_conventions_headers",
        "libberberis_guest_state_headers",
        "libberberis_runtime_library_headers",
        "libberberis_runtime_primitives_headers",
    ],
}

cc_library_headers {
    name: "libberberis_guest_abi_arm_or_arm64_headers",
    defaults: ["berberis_guest_agnostic_defaults"],
    host_supported: true,
    arch: {
        x86: {
            cflags: ["-DNATIVE_BRIDGE_GUEST_ARCH_ARM=1"],
            header_libs: ["libberberis_guest_abi_arm_headers"],
            export_header_lib_headers: ["libberberis_guest_abi_arm_headers"],
        },
        x86_64: {
            cflags: ["-DNATIVE_BRIDGE_GUEST_ARCH_ARM64=1"],
            header_libs: ["libberberis_guest_abi_arm64_headers"],
            export_header_lib_headers: ["libberberis_guest_abi_arm64_headers"],
        },
        riscv64: {
            cflags: ["-DNATIVE_BRIDGE_GUEST_ARCH_ARM64=1"],
            header_libs: ["libberberis_guest_abi_arm64_headers"],
            export_header_lib_headers: ["libberberis_guest_abi_arm64_headers"],
        },
    },
}

cc_library_static {
    name: "libberberis_guest_abi_arm_or_arm64",
    defaults: ["berberis_guest_agnostic_defaults"],
    host_supported: true,
    header_libs: ["libberberis_guest_abi_arm_or_arm64_headers"],
    export_header_lib_headers: ["libberberis_guest_abi_arm_or_arm64_headers"],
    arch: {
        x86: {
            whole_static_libs: ["libberberis_guest_abi_arm"],
        },
        x86_64: {
            whole_static_libs: ["libberberis_guest_abi_arm64"],
        },
        riscv64: {
            whole_static_libs: ["libberberis_guest_abi_arm64"],
        },
    },
}

cc_test_library {
    name: "libberberis_guest_abi_unit_tests",
    defaults: ["berberis_test_library_defaults"],
    srcs: [
        "guest_function_wrapper_signature_test.cc",
    ],
    header_libs: ["libberberis_guest_abi_headers"],
}
