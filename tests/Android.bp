// berberis_host_tests
genrule_defaults {
    name: "berberis_host_tests_defaults",
    compile_multilib: "64",
    host_supported: true,
    device_supported: false,
    srcs: [
        ":libbase",
        ":libc++",
        ":liblog",
        ":berberis_host_tests_data_32",
        ":berberis_host_tests_data_64",
    ],
    host_first_srcs: [
        ":berberis_gen_gtest_failure_template",
    ],
    cmd: "TEST_BINARY=$$(echo $(in) | tr ' ' '\n' | grep berberis_host_tests | grep -v data |  tr '\n' ' ')" + // Pick the actual test binary from input.
        // Wrap in a shell command to delay variable substitution until it's executed. Otherwise
        // TEST_BINARY would be undefined.
        " sh -c '" +
        " cp -t $(genDir) $${TEST_BINARY} $(location :liblog) $(location :libc++) $(location :libbase)" +
        " && mkdir -p $(genDir)/tiny_loader/tests/files/32 $(genDir)/tiny_loader/tests/files/64" +
        " && cp -t $(genDir)/tiny_loader/tests/files/32 $(locations :berberis_host_tests_data_32)" +
        " && cp -t $(genDir)/tiny_loader/tests/files/64 $(locations :berberis_host_tests_data_64)" +
        " && $(genDir)/$$(basename $${TEST_BINARY}) --gtest_output=xml:$(out) ; true" +
        // END OF "sh -c"
        "'",
    dist: {
        targets: ["berberis_host_tests_result"],
        dir: "gtest",
    },
    enabled: select(soong_config_variable("berberis", "translation_arch"), {
        "riscv64_to_x86_64": true,
        default: false,
    }),
    target: {
        windows: {
            enabled: false,
        },
    },
}

cc_genrule {
    name: "berberis_host_tests_64_run_test",
    defaults: ["berberis_host_tests_defaults"],
    out: ["berberis_host_tests_64_result.xml"],
    srcs: [
        ":berberis_host_tests",
    ],
}

cc_genrule {
    name: "berberis_host_tests_avx_64_run_test",
    defaults: ["berberis_host_tests_defaults"],
    out: ["berberis_host_tests_avx_64_result.xml"],
    srcs: [
        ":berberis_host_tests_avx",
    ],
}

cc_genrule {
    name: "berberis_host_tests_no_avx_64_run_test",
    defaults: ["berberis_host_tests_defaults"],
    out: ["berberis_host_tests_no_avx_64_result.xml"],
    srcs: [
        ":berberis_host_tests_no_avx",
    ],
}

cc_genrule {
    name: "berberis_run_host_tests_check_errors",
    out: [
        "timestamp",
    ],
    cmd: "( [[ \"$$(grep -L 'testsuites.*failures=\"0\"' $(in))\" == \"\" ]] && touch $(out)) || (echo \"Errors found in:\" ; grep -L 'testsuites.*failures=\"0\"' $(in) ; exit 1)",
    host_first_srcs: [
        ":berberis_host_tests_64_run_test",
        ":berberis_host_tests_avx_64_run_test",
        ":berberis_host_tests_no_avx_64_run_test",
    ],
    enabled: select(soong_config_variable("berberis", "translation_arch"), {
        "riscv64_to_x86_64": true,
        default: false,
    }),
}

cc_genrule {
    name: "berberis_run_risc64_tests_check_errors",
    out: [
        "timestamp",
    ],
    cmd: "( [[ \"$$(grep -L 'testsuites.*failures=\"0\"' $(in))\" == \"\" ]] && touch $(out)) || (echo \"Errors found in:\" ; grep -L 'testsuites.*failures=\"0\"' $(in) ; exit 1)",
    srcs: [
        ":berberis_ndk_program_tests_interpret_only_run_test_x86_64_riscv64",
        ":berberis_ndk_program_tests_lite_translate_or_interpret_run_test_x86_64_riscv64",
        ":berberis_ndk_program_tests_heavy_optimize_or_interpret_run_test_x86_64_riscv64",
        ":berberis_ndk_program_tests_two_gear_run_test_x86_64_riscv64",
        ":inline_asm_tests_riscv64_interpret_only_run_test_x86_64_riscv64",
        ":inline_asm_tests_riscv64_lite_translate_or_interpret_run_test_x86_64_riscv64",
        ":inline_asm_tests_riscv64_heavy_optimize_or_interpret_run_test_x86_64_riscv64",
        ":inline_asm_tests_riscv64_two_gear_run_test_x86_64_riscv64",
    ],
    native_bridge_supported: true,
    compile_multilib: "64",
    enabled: false,
    arch: {
        riscv64: {
            enabled: true,
        },
    },
}
