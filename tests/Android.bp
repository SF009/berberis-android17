package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

phony_rule {
    name: "berberis_host_tests_result",
    phony_deps: select(soong_config_variable("berberis", "translation_arch"), {
        "riscv64_to_x86_64": [
            "berberis_host_tests_64_run_test",
            "berberis_host_tests_avx_64_run_test",
            "berberis_host_tests_no_avx_64_run_test",
            "berberis_ndk_program_tests_interpret_only_run_test_x86_64_riscv64",
            "berberis_ndk_program_tests_lite_translate_or_interpret_run_test_x86_64_riscv64",
            "berberis_ndk_program_tests_heavy_optimize_or_interpret_run_test_x86_64_riscv64",
            "berberis_ndk_program_tests_two_gear_run_test_x86_64_riscv64",
            "inline_asm_tests_riscv64_interpret_only_run_test_x86_64_riscv64",
            "inline_asm_tests_riscv64_lite_translate_or_interpret_run_test_x86_64_riscv64",
            "inline_asm_tests_riscv64_heavy_optimize_or_interpret_run_test_x86_64_riscv64",
            "inline_asm_tests_riscv64_two_gear_run_test_x86_64_riscv64",
        ],
        default: [
        ],
    }),
}

phony_rule {
    name: "berberis_run_host_tests",
    phony_deps: select(soong_config_variable("berberis", "translation_arch"), {
        "riscv64_to_x86_64": [
            "berberis_run_host_tests_check_errors",
            "berberis_run_risc64_tests_check_errors",
        ],
        default: [
        ],
    }),

}

// berberis_ndk_program_tests
genrule_defaults {
    name: "berberis_ndk_program_tests_riscv64_defaults",
    native_bridge_supported: true,
    compile_multilib: "64",
    enabled: false,
    arch: {
        riscv64: {
            enabled: true,
        },
    },
    host_first_srcs: [
        ":berberis_gen_gtest_failure_template",
        ":berberis_program_runner_riscv64",
        ":libbase",
        ":liblog",
        ":libc++",
        ":libberberis_riscv64",
    ],
    // Force running with the prebuilt host libc due to b/254755879.
    srcs: [
        ":gcc.sysroot",
        ":gcc.lib64",
        ":gcc.lib",
        ":gcc.lib32",
    ],
    dist: {
        targets: ["berberis_host_tests_result"],
        dir: "gtest",
    },
}

ld_library_path = " LD_LIBRARY_PATH=prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8/x86_64-linux/lib64:prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8/sysroot/usr/lib"
prebuilt_ld = "prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8/sysroot/usr/lib/ld-linux-x86-64.so.2"

cc_genrule {
    name: "berberis_ndk_program_tests_interpret_only_run_test_x86_64_riscv64",
    defaults: ["berberis_ndk_program_tests_riscv64_defaults"],
    out: ["berberis_ndk_program_tests_interpret_only_result.xml"],
    srcs: [
        ":berberis_ndk_program_tests_static",
    ],
    cmd: "$(location :berberis_gen_gtest_failure_template) berberis_host_tests_riscv64 berberis_ndk_program_tests_interpret_only > $(out)" +
        " && cp -t $(genDir) $(location :berberis_program_runner_riscv64) $(location :liblog) $(location :libc++) $(location :libbase) $(location :libberberis_riscv64)" +
        " && BERBERIS_MODE=interpret-only" +
        ld_library_path + " " + prebuilt_ld + " $(genDir)/berberis_program_runner_riscv64 $(location :berberis_ndk_program_tests_static) --gtest_output=xml:$(out) ; true",
}

cc_genrule {
    name: "berberis_ndk_program_tests_lite_translate_or_interpret_run_test_x86_64_riscv64",
    defaults: ["berberis_ndk_program_tests_riscv64_defaults"],
    out: ["berberis_ndk_program_tests_lite_translate_or_interpret_result.xml"],
    srcs: [
        ":berberis_ndk_program_tests_static",
    ],
    cmd: "$(location :berberis_gen_gtest_failure_template) berberis_host_tests_riscv64 berberis_ndk_program_tests_lite_translate_or_interpret > $(out)" +
        " && cp -t $(genDir) $(location :berberis_program_runner_riscv64) $(location :liblog) $(location :libc++) $(location :libbase) $(location :libberberis_riscv64)" +
        " && BERBERIS_MODE=lite-translate-or-interpret" +
        ld_library_path + " " + prebuilt_ld + " $(genDir)/berberis_program_runner_riscv64 $(location :berberis_ndk_program_tests_static) --gtest_output=xml:$(out) ; true",
}

cc_genrule {
    name: "berberis_ndk_program_tests_heavy_optimize_or_interpret_run_test_x86_64_riscv64",
    defaults: ["berberis_ndk_program_tests_riscv64_defaults"],
    out: ["berberis_ndk_program_tests_heavy_optimize_or_interpret_result.xml"],
    srcs: [
        ":berberis_ndk_program_tests_static",
    ],
    cmd: "$(location :berberis_gen_gtest_failure_template) berberis_host_tests_riscv64 berberis_ndk_program_tests_heavy_optimize_or_interpret > $(out)" +
        " && cp -t $(genDir) $(location :berberis_program_runner_riscv64) $(location :liblog) $(location :libc++) $(location :libbase) $(location :libberberis_riscv64)" +
        " && BERBERIS_MODE=heavy-optimize-or-interpret" +
        ld_library_path + " " + prebuilt_ld + " $(genDir)/berberis_program_runner_riscv64 $(location :berberis_ndk_program_tests_static) --gtest_output=xml:$(out) ; true",
}

cc_genrule {
    name: "berberis_ndk_program_tests_two_gear_run_test_x86_64_riscv64",
    defaults: ["berberis_ndk_program_tests_riscv64_defaults"],
    out: ["berberis_ndk_program_tests_two_gear_result.xml"],
    srcs: [
        ":berberis_ndk_program_tests_static",
    ],
    cmd: "$(location :berberis_gen_gtest_failure_template) berberis_host_tests_riscv64 berberis_ndk_program_tests_two_gear > $(out)" +
        " && cp -t $(genDir) $(location :berberis_program_runner_riscv64) $(location :liblog) $(location :libc++) $(location :libbase) $(location :libberberis_riscv64)" +
        " && BERBERIS_MODE=two-gear" +
        ld_library_path + " " + prebuilt_ld + " $(genDir)/berberis_program_runner_riscv64 $(location :berberis_ndk_program_tests_static) --gtest_output=xml:$(out) ; true",
}

