package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_headers {
    name: "libberberis_runtime_headers",
    defaults: [
        "berberis_enable_arm64_host_defaults",
        "berberis_guest_agnostic_defaults",
    ],
    host_supported: true,
    export_include_dirs: ["include"],
}

filegroup {
    name: "berberis_runtime_srcs",
    srcs: [
        "berberis.cc",
        "execute_guest.cc",
        "execute_guest_call.cc",
    ],
}

cc_defaults {
    name: "libberberis_runtime_defaults",
    defaults: [
        "berberis_guest_agnostic_defaults",
    ],
    host_supported: true,
    header_libs: [
        "libberberis_base_headers",
        "libberberis_calling_conventions_headers",
        "libberberis_guest_os_primitives_headers",
        "libberberis_guest_state_headers",
        "libberberis_instrument_headers",
        "libberberis_runtime_headers",
        "libberberis_runtime_primitives_headers",
        "libberberis_translator_headers",
    ],
    srcs: [
        ":berberis_runtime_srcs",
    ],
}

cc_library_static {
    name: "libberberis_runtime_arm_or_arm64",
    defaults: [
        "berberis_arm_or_arm64_defaults",
        "libberberis_runtime_defaults",
    ],
    host_supported: true,
    header_libs: [
        "libberberis_guest_abi_arm_or_arm64_headers",
        "libberberis_guest_state_arm_or_arm64_headers",
    ],
    arch: {
        x86: {
            header_libs: [
                "libberberis_kernel_api_headers",
            ],
            srcs: [
                "arm32/init_guest_arch.cc",
                "arm32/run_guest_call.cc",
            ],
        },
        x86_64: {
            srcs: [
                "arm64/init_guest_arch.cc",
                "arm64/run_guest_call.cc",
            ],
        },
        riscv64: {
            srcs: [
                "arm64/init_guest_arch.cc",
                "arm64/run_guest_call.cc",
            ],
        },
    },
}

cc_test_library {
    name: "libberberis_runtime_arm_or_arm64_unit_tests",
    defaults: ["berberis_arm_or_arm64_defaults"],
    host_supported: true,
    header_libs: [
        "berberis_test_utils_headers",
        "libberberis_assembler_headers",
        "libberberis_guest_state_arm_or_arm64_headers",
        "libberberis_runtime_primitives_headers",
    ],
    arch: {
        x86: {
            srcs: [
                "arm32_to_x86_32/run_generated_code_test.cc",
            ],
        },
        x86_64: {
            srcs: [
                "arm64_to_x86_64/run_generated_code_test.cc",
            ],
        },
    },
    shared: {
        enabled: false,
    },
}
