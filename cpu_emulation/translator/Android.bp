package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_headers {
    name: "libberberis_translator_headers",
    defaults: [
        "berberis_enable_arm64_host_defaults",
        "berberis_guest_agnostic_defaults",
    ],
    host_supported: true,
    export_include_dirs: ["include"],
}

cc_library_static {
    name: "libberberis_translator_riscv64",
    defaults: [
        "berberis_enable_arm64_host_defaults",
        "berberis_riscv64_defaults",
    ],
    host_supported: true,
    header_libs: [
        "libberberis_base_headers",
        // TODO(b/476465845): Remove this dep.
        "libberberis_guest_os_primitives_headers",
        "libberberis_guest_state_riscv64_headers",
        "libberberis_interpreter_riscv64_headers",
        "libberberis_runtime_headers",
        "libberberis_runtime_library_headers",
        "libberberis_runtime_primitives_headers",
        "libberberis_translator_headers",
    ],
    srcs: [
        "riscv64/translator.cc",
    ],
    arch: {
        arm64: {
            srcs: [
                "riscv64/translator_arm64.cc",
            ],
        },
        x86_64: {
            header_libs: [
                "libberberis_heavy_optimizer_riscv64_headers",
                "libberberis_lite_translator_headers",
            ],
            srcs: [
                "riscv64/translator_x86_64.cc",
            ],
        },
    },
}

cc_test_library {
    name: "libberberis_translator_riscv64_unit_tests",
    defaults: ["berberis_test_library_defaults_64"],
    header_libs: [
        "berberis_test_utils_headers",
        "libberberis_base_headers",
        "libberberis_guest_os_primitives_headers",
        "libberberis_guest_state_riscv64_headers",
        "libberberis_runtime_headers",
        "libberberis_runtime_primitives_headers",
    ],
    arch: {
        x86_64: {
            srcs: [
                "riscv64/translator_x86_64_test.cc",
            ],
            header_libs: [
                "libberberis_lite_translator_headers",
            ],
        },
    },

}
